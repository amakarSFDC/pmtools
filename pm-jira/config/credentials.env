# JIRA PM Scripts — Credentials Configuration
# Fill in your values below, then run: source config/credentials.env
#
# JIRA_EMAIL             : your Atlassian account email
# JIRA_API_TOKEN         : generate at https://id.atlassian.net/manage-api-tokens
# JIRA_BASE_URL          : your Atlassian domain (e.g. https://yourcompany.atlassian.net)
# JIRA_DEFAULT_ASSIGNEE  : JIRA account ID to use when assignee lookup fails in Script 3
#                          (find via: curl -u email:token https://yourcompany.atlassian.net/rest/api/3/user/search?query=name)
# SLACK_CHANNEL          : Slack channel ID for posting DoR results and status updates
# DRIVE_FOLDER           : Google Drive folder ID for standup notes (used by Script 8)

export JIRA_EMAIL=your_email@company.com
export JIRA_API_TOKEN=your_api_token_here
export JIRA_BASE_URL=https://yourcompany.atlassian.net
export JIRA_DEFAULT_ASSIGNEE=
export SLACK_CHANNEL=
export DRIVE_FOLDER=
