# Salesforce PM Scripts — Configuration
# Copy this file to config/salesforce.env.local, adjust if needed, then run:
#   source config/salesforce.env.local
#
# SF_ALIAS             : local alias `sf` uses to remember this org's auth (no secrets
#                         stored here — `sf org login web` handles OAuth and keeps
#                         tokens in ~/.sfdx/)
# SF_INSTANCE_URL      : your org's My Domain login URL
# SF_REPORT_API_VERSION: REST API version used in report URLs (e.g. v64.0)
#                         NOTE: intentionally not named SF_API_VERSION — that name is
#                         reserved by the `sf` CLI itself as a global version override
#                         and expects a bare number ("64.0"), not "v64.0".

export SF_ALIAS=hui
export SF_INSTANCE_URL=https://hui.my.salesforce.com
export SF_REPORT_API_VERSION=v64.0
